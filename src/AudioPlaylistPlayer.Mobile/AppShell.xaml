<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="AudioPlaylistPlayer.Mobile.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:AudioPlaylistPlayer.Mobile"
       Shell.FlyoutBehavior="Disabled">

    <!-- Главная страница по умолчанию -->
    <ShellContent Title="Главная"
                  ContentTemplate="{DataTemplate local:HomePage}"
                  Route="HomePage" />

    <!-- Остальные страницы регистрируем для навигации, но не показываем во вкладках -->
    <ShellContent Route="AllTracksPage" ContentTemplate="{DataTemplate local:AllTracksPage}" Shell.FlyoutBehavior="Disabled" />
    <ShellContent Route="PlaylistsPage" ContentTemplate="{DataTemplate local:PlaylistsPage}" Shell.FlyoutBehavior="Disabled" />
    <ShellContent Route="PlaylistDetailPage" ContentTemplate="{DataTemplate local:PlaylistDetailPage}" Shell.FlyoutBehavior="Disabled" />
    <ShellContent Route="QueuePage" ContentTemplate="{DataTemplate local:QueuePage}" Shell.FlyoutBehavior="Disabled" />

</Shell>