<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AudioPlaylistPlayer.Mobile.Controls"
             x:Class="AudioPlaylistPlayer.Mobile.PlaylistsPage"
             Title="Плейлисты">

    <CollectionView ItemsSource="{Binding Playlists}">
        <CollectionView.Header>
            <!-- Карточка "Создать плейлист" -->
            <Frame Padding="15" Margin="20,20,20,10" CornerRadius="12" HasShadow="False" BackgroundColor="#E8E8E8" HeightRequest="80">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CreatePlaylistCommand}" />
                </Frame.GestureRecognizers>
                <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                    <Label Text="➕" FontSize="24" VerticalOptions="Center" />
                    <Label Text="Создать плейлист" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Frame>
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <controls:PlaylistListItem BindingContext="{Binding .}" />
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>